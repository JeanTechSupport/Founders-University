---
import { liveQa, type Locale } from "../content/site";

interface Props {
  locale: Locale;
  /** Extra classes, e.g. `btn--lg` in the FAQ column. */
  class?: string;
}

const { locale, class: className } = Astro.props;
const label = liveQa.label[locale];
---

{
  liveQa.url ? (
    <a
      class:list={["btn", "btn--ghost", className]}
      href={liveQa.url}
      data-magnetic="0.3"
      data-cursor="Join"
      data-umami-event="Live Q&A"
    >
      <span>{label}</span>
    </a>
  ) : (
    /* No destination yet — render a non-interactive chip rather than a dead link,
       so nobody clicks through to nothing. Setting `liveQa.url` turns it into a
       real button everywhere it appears. */
    <span class:list={["btn", "btn--ghost", "btn--soon", className]}>
      <span>{label}</span>
      <span class="btn__soon">{liveQa.soonLabel[locale]}</span>
    </span>
  )
}
